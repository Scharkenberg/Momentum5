<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Momentum5.App.Controls.CompactHome"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Momentum5.App.Controls"
    xmlns:svc="using:Momentum5.App.Services">
	<UserControl.Resources>
		<x:Double x:Key="RowMinHeight">32</x:Double>
	</UserControl.Resources>
	<StackPanel x:Name="Stack" Margin="0,0,0,2" Spacing="6" VerticalAlignment="Top">
		<Border Style="{StaticResource CompactCard}" Padding="8">
			<StackPanel Spacing="4">
				<c:SegmentedControl Dense="True" Options="Adaptive,Custom,Off" SelectedIndex="{x:Bind Vm.Noise.UiModeIndex, Mode=TwoWay}" IsEnabled="{x:Bind Vm.Noise.ModeEnabled, Mode=OneWay}" AutomationProperties.Name="Noise control mode" />
				<Slider Minimum="0" Maximum="100" StepFrequency="1" Margin="4,0" Value="{x:Bind Vm.Noise.Level.NumericValue, Mode=TwoWay}" IsEnabled="{x:Bind Vm.Noise.LevelEnabled, Mode=OneWay}" AutomationProperties.Name="Noise cancelling to transparency" />
				<Grid Margin="4,0">
					<TextBlock Text="{x:Bind Vm.Noise.AncText, Mode=OneWay}" Style="{StaticResource CaptionStyle}" />
					<TextBlock Text="{x:Bind Vm.Noise.TransparencyText, Mode=OneWay}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
				</Grid>
			</StackPanel>
		</Border>

		<Border Style="{StaticResource CompactCard}" Padding="8,0">
			<StackPanel>
				<c:SwitchRow Title="Anti-wind" IsOn="{x:Bind Vm.Noise.WindOn, Mode=TwoWay}" IsEnabled="{x:Bind Vm.Noise.WindOnEnabled, Mode=OneWay}" />
				<c:SwitchRow Title="Auto-pause" IsOn="{x:Bind Vm.Noise.AutoPause.Value, Mode=TwoWay}" IsEnabled="{x:Bind Vm.Noise.AutoPause.IsEnabled, Mode=OneWay}" />
				<c:SwitchRow Title="Transparency on calls" IsOn="{x:Bind Vm.Noise.CallsOn, Mode=TwoWay}" IsEnabled="{x:Bind Vm.Noise.PhoneCalls.IsEnabled, Mode=OneWay}" />
				<c:SwitchRow Title="Bass boost" IsOn="{x:Bind Vm.BassBoost.Value, Mode=TwoWay}" IsEnabled="{x:Bind Vm.BassBoost.IsEnabled, Mode=OneWay}" />
				<c:SwitchRow Title="Immersive audio" IsOn="{x:Bind Vm.Immersive.Value, Mode=TwoWay}" IsEnabled="{x:Bind Vm.Immersive.IsEnabled, Mode=OneWay}" />
			</StackPanel>
		</Border>

		<Border Style="{StaticResource CompactCard}" Padding="8,4">
			<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
				<FontIcon Glyph="&#xE8D6;" FontSize="16" VerticalAlignment="Center" />
				<ComboBox Grid.Column="1" HorizontalAlignment="Stretch" MinHeight="32" PlaceholderText="EQ preset" ItemsSource="{x:Bind Presets.Items}" DisplayMemberPath="Name"
				          SelectionChanged="Preset_SelectionChanged" AutomationProperties.Name="EQ preset" />
			</Grid>
		</Border>

		<Border Style="{StaticResource CompactCard}" Padding="8,6" Visibility="{x:Bind svc:UiFn.Vis(Vm.ConnectedText), Mode=OneWay}">
			<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
				<FontIcon Glyph="&#xE7F8;" FontSize="16" VerticalAlignment="Top" />
				<TextBlock Grid.Column="1" Text="{x:Bind Vm.ConnectedText, Mode=OneWay}" Style="{StaticResource CaptionStyle}" />
			</Grid>
		</Border>
	</StackPanel>
</UserControl>
