<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Momentum5.App.Controls.NoiseCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Momentum5.App.Controls"
    xmlns:svc="using:Momentum5.App.Services">
	<Border Style="{StaticResource CardBorder}">
		<StackPanel Spacing="{StaticResource InnerSpacing}">
			<Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource InnerSpacing}">
				<Grid Width="36" Height="36" VerticalAlignment="Top">
					<Border CornerRadius="{StaticResource RadiusM}" Background="{StaticResource BrandGradientBrush}" />
					<FontIcon Glyph="&#xE767;" FontSize="16" Foreground="White" />
				</Grid>
				<StackPanel Grid.Column="1" VerticalAlignment="Center">
					<TextBlock Text="Noise control" Style="{StaticResource CardTitleStyle}" />
					<TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind Vm.ModeHint, Mode=OneWay}" TextWrapping="Wrap" />
				</StackPanel>
			</Grid>
			<c:SegmentedControl Options="Adaptive,Custom,Off" SelectedIndex="{x:Bind Vm.UiModeIndex, Mode=TwoWay}" IsEnabled="{x:Bind Vm.ModeEnabled, Mode=OneWay}" AutomationProperties.Name="Noise control mode" />
			<Slider Minimum="0" Maximum="100" StepFrequency="1" TickFrequency="50" TickPlacement="Outside"
			        Value="{x:Bind Vm.Level.NumericValue, Mode=TwoWay}" IsEnabled="{x:Bind Vm.LevelEnabled, Mode=OneWay}"
			        AutomationProperties.Name="Noise cancelling to transparency" />
			<Grid>
				<TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind Vm.AncText, Mode=OneWay}" />
				<TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind Vm.TransparencyText, Mode=OneWay}" HorizontalAlignment="Right" />
			</Grid>
			<TextBlock Text="{x:Bind Vm.Level.Warning, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Visibility="{x:Bind svc:UiFn.Vis(Vm.Level.Warning), Mode=OneWay}" />
			<Rectangle Height="1" Fill="{ThemeResource CardEdgeBrush}" />
			<c:SwitchRow Title="Anti-wind" Description="Reduce wind noise in ANC." IsOn="{x:Bind Vm.WindOn, Mode=TwoWay}" IsEnabled="{x:Bind Vm.WindOnEnabled, Mode=OneWay}" />
		</StackPanel>
	</Border>
</UserControl>
