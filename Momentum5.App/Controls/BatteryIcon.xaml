<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Momentum5.App.Controls.BatteryIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- Hand-built (not a font glyph) so every edge lands on whole device pixels: body 24x14 DIP, 1.5 DIP outline, 2 DIP gap, 17 DIP max fill -->
	<Grid x:Name="Box" Width="28" Height="14" UseLayoutRounding="True" VerticalAlignment="Center">
		<Border x:Name="Body" Width="24" HorizontalAlignment="Left" BorderThickness="1.333" CornerRadius="3.5" />
		<Border x:Name="Fill" Margin="2.667,2.667,0,2.667" HorizontalAlignment="Left" CornerRadius="1.5" />
		<Border x:Name="Cap" Width="3" Height="6" HorizontalAlignment="Right" CornerRadius="0,1.5,1.5,0" />
		<Grid Width="24" HorizontalAlignment="Left">
			<FontIcon x:Name="Bolt" Glyph="&#xE945;" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
		</Grid>
	</Grid>
</UserControl>
