<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Momentum5.App.Controls.ToggleRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Momentum5.App.Services">
	<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource InnerSpacing}" MinHeight="{ThemeResource RowMinHeight}">
		<StackPanel VerticalAlignment="Center" Spacing="2">
			<TextBlock Text="{x:Bind Title, Mode=OneWay}" TextWrapping="Wrap" />
			<TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind Description, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind svc:UiFn.Vis(Description), Mode=OneWay}" />
			<TextBlock Text="{x:Bind Setting.Warning, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Visibility="{x:Bind svc:UiFn.Vis(Setting.Warning), Mode=OneWay}" />
		</StackPanel>
		<ToggleSwitch Grid.Column="1" IsOn="{x:Bind Setting.Value, Mode=TwoWay}" IsEnabled="{x:Bind Setting.IsEnabled, Mode=OneWay}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
	</Grid>
</UserControl>
