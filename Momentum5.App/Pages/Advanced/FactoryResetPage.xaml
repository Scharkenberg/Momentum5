<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Momentum5.App.Pages.Advanced.FactoryResetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cp="using:Momentum5.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            Padding="{ThemeResource PageMargin}"
            Spacing="{ThemeResource PageSpacing}"
            MaxWidth="1000"
            HorizontalAlignment="Stretch">

            <!-- Persistent warning: the destructive scope of the page (house style: top InfoBar) -->
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Severity="Warning"
                Title="Cannot be undone"
                Message="A factory reset erases every pairing and all settings on the headphones, and this app forgets the last device."
                AutomationProperties.Name="Factory reset warning" />

            <TextBlock
                Text="{x:Bind ViewModel.Warning, Mode=OneWay}"
                Visibility="{x:Bind WarningVis(ViewModel.Warning), Mode=OneWay}"
                Style="{ThemeResource BaseTextBlockStyle}"
                Foreground="{ThemeResource StatusBadBrush}"
                TextWrapping="Wrap" />

            <TextBlock
                Text="{x:Bind ViewModel.StatusNote, Mode=OneWay}"
                Visibility="{x:Bind TextVis(ViewModel.StatusNote), Mode=OneWay}"
                Style="{ThemeResource BaseTextBlockStyle}"
                Foreground="{ThemeResource StatusGoodBrush}"
                TextWrapping="Wrap" />

            <!-- Explanation -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusL}"
                Padding="{ThemeResource CardPadding}">
                <StackPanel Spacing="8">
                    <TextBlock Text="What a factory reset does" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock
                        Text="A factory reset returns the MOMENTUM 5 Wireless to its out-of-the-box state."
                        Style="{ThemeResource BodyTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="Every pairing is erased — the headphones forget all devices they are paired with."
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="All device-side settings revert to the defaults: ANC, transparency, the equalizer, side tones and every toggle."
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="This app forgets the last device, so auto-connect will not reattach on its own."
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="Your equalizer presets saved in this app are kept — only the device-side state is erased."
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="Warning: there is no way to recover the erased pairings or settings."
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Foreground="{ThemeResource StatusBadBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Arming + reset -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusL}"
                Padding="{ThemeResource CardPadding}">
                <StackPanel Spacing="{StaticResource InnerSpacing}">
                    <TextBlock Text="Reset the headphones" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock
                        Text="Check the box to arm the page, then choose Factory reset. The confirmation dialog asks you to type RESET and keeps the confirm button locked for five seconds."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <CheckBox
                        MinHeight="{ThemeResource RowMinHeight}"
                        IsChecked="{x:Bind ViewModel.Acknowledged, Mode=TwoWay}"
                        IsEnabled="{x:Bind CanArm(ViewModel.ResetDone), Mode=OneWay}"
                        AutomationProperties.Name="Acknowledge that all settings and pairings on the headphones will be erased">
                        <TextBlock
                            Text="I understand that all settings and pairings on the headphones will be erased"
                            TextWrapping="Wrap" />
                    </CheckBox>
                    <Button
                        Content="Factory reset…"
                        HorizontalAlignment="Left"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnResetClick"
                        IsEnabled="{x:Bind CanReset(ViewModel.IsConnected, ViewModel.Acknowledged, ViewModel.IsResetting, ViewModel.ResetDone), Mode=OneWay}"
                        AutomationProperties.Name="Factory reset the headphones (opens a typed-confirmation dialog)"
                        ToolTipService.ToolTip="Opens the typed-RESET confirmation dialog; the reset command is S:0040 (Dangerous)." />
                    <TextBlock
                        Text="Connect the headphones in Windows first, then open this page."
                        Visibility="{x:Bind NotConnectedVis(ViewModel.IsConnected), Mode=OneWay}"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <ProgressBar
                        IsIndeterminate="True"
                        Visibility="{x:Bind BusyVis(ViewModel.IsResetting), Mode=OneWay}"
                        AutomationProperties.Name="Sending the factory reset" />
                    <TextBlock
                        Text="{x:Bind ViewModel.SessionText, Mode=OneWay}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Re-pair guide: shown after the reset flow ran (stays on the cached page) -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusL}"
                Padding="{ThemeResource CardPadding}"
                Visibility="{x:Bind DoneVis(ViewModel.ResetDone), Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Re-pair the headphones" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock
                        Text="The reset is complete. To use the headphones with this PC again:"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="1. The headphones are in pairing mode after a reset (or hold the pairing button until the voice prompt)."
                        MinHeight="{ThemeResource RowMinHeight}"
                        VerticalAlignment="Center"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="2. Pair them from Windows Settings → Bluetooth &amp; devices."
                        MinHeight="{ThemeResource RowMinHeight}"
                        VerticalAlignment="Center"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="3. Open Momentum5 and connect."
                        MinHeight="{ThemeResource RowMinHeight}"
                        VerticalAlignment="Center"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="The app forgot the last device — pair and connect once, and it is remembered again. Your EQ presets were kept."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Notes -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusL}"
                Padding="{ThemeResource CardPadding}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Notes" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="The raw command is S:0040 (Sennheiser, Dangerous class). It is sent only with the single-use consent token issued by the typed-RESET dialog (X-02), and every execution is logged."
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="This page needs DevMode — the whole Advanced area is DevMode-gated at the shell level."
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="If the link drops right after the reset command, that is expected: the headphones power-cycle during the reset."
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="The equalizer presets saved in this app are never touched by this flow — they are app-side."
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
