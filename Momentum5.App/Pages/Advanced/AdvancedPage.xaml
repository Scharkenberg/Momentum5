<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Momentum5.App.Pages.Advanced.AdvancedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <NavigationView
        x:Name="SubNav"
        PaneDisplayMode="Top"
        IsBackButtonVisible="Collapsed"
        AutomationProperties.Name="Advanced sections"
        SelectionChanged="OnSelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Console" Tag="console" AutomationProperties.Name="GAIA console" />
            <NavigationViewItem Content="Parametric EQ" Tag="peq" AutomationProperties.Name="Parametric EQ" />
            <NavigationViewItem Content="Touch buttons" Tag="mmi" AutomationProperties.Name="Touch buttons" />
            <NavigationViewItem Content="Factory reset" Tag="reset" AutomationProperties.Name="Factory reset" />
            <NavigationViewItem Content="Firmware" Tag="firmware" AutomationProperties.Name="Firmware update" />
        </NavigationView.MenuItems>
        <Frame x:Name="SubFrame" />
    </NavigationView>
</Page>
