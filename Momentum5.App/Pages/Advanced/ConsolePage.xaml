<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Momentum5.App.Pages.Advanced.ConsolePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cp="using:Momentum5.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Momentum5.App.ViewModels"
    xmlns:pages="using:Momentum5.App.Pages.Advanced"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            Padding="{ThemeResource PageMargin}"
            Spacing="{ThemeResource PageSpacing}"
            MaxWidth="1000"
            HorizontalAlignment="Stretch">

            <!-- Header: what this page is + live session state -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusL}"
                Padding="{ThemeResource CardPadding}">
                <StackPanel Spacing="8">
                    <TextBlock Text="GAIA console" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock
                        Text="DevTools console for the M5 command catalog: browse every known GAIA command and send guarded frames. Reads send GET, writes send SET, Unknown commands probe GET-only, Dangerous commands are refused, and Blocked commands need a per-command unlock typed once per session. Safety rules are enforced again by the pipeline for every frame."
                        Opacity="0.72"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing
                            Width="14"
                            Height="14"
                            IsActive="{x:Bind ViewModel.IsSending, Mode=OneWay}"
                            AutomationProperties.Name="Console busy indicator" />
                        <TextBlock
                            Text="{x:Bind ViewModel.SessionText, Mode=OneWay}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Catalog browser: text + safety-class filter over GaiaCatalog bindings and raw rows -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusL}"
                Padding="{ThemeResource CardPadding}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Command catalog" Style="{StaticResource CardTitleStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="FilterBox"
                            Grid.Column="0"
                            Header="Filter"
                            PlaceholderText="Name, word, vendor, note…"
                            TextChanged="OnFilterChanged"
                            AutomationProperties.Name="Catalog filter" />
                        <ComboBox
                            x:Name="SafetyFilter"
                            Grid.Column="1"
                            Header="Safety class"
                            SelectedIndex="0"
                            SelectionChanged="OnSafetyFilterChanged"
                            AutomationProperties.Name="Safety class filter">
                            <ComboBoxItem Content="All" />
                            <ComboBoxItem Content="Read" />
                            <ComboBoxItem Content="Write" />
                            <ComboBoxItem Content="Gated" />
                            <ComboBoxItem Content="Dangerous" />
                            <ComboBoxItem Content="Blocked" />
                            <ComboBoxItem Content="Unknown" />
                        </ComboBox>
                    </Grid>
                    <ListView
                        x:Name="CatalogList"
                        ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}"
                        SelectionMode="Single"
                        MaxHeight="440"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollMode="Auto"
                        AutomationProperties.Name="GAIA command catalog"
                        ToolTipService.ToolTip="Select a command to load it into the sender">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="44" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CatalogRowVm">
                                <StackPanel Padding="4,2" Spacing="2">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind SafetyText}" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                    </Grid>
                                    <cp:WrapPanel HorizontalSpacing="8" VerticalSpacing="0">
                                        <TextBlock Text="{x:Bind VendorText}" Style="{ThemeResource CaptionTextBlockStyle}" FontFamily="Cascadia Mono,Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind WordsText}" Style="{ThemeResource CaptionTextBlockStyle}" FontFamily="Cascadia Mono,Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind GroupText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </cp:WrapPanel>
                                    <TextBlock Text="{x:Bind NoteText}" Visibility="{x:Bind pages:ConsolePage.TextVisStatic(NoteText)}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <cp:WrapPanel HorizontalSpacing="{StaticResource InnerSpacing}" VerticalSpacing="0">
                        <TextBlock
                            Text="{x:Bind ViewModel.RowCountText, Mode=OneWay}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="S = Sennheiser (0x0495) · Q = Qualcomm (0x001D)"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </cp:WrapPanel>
                </StackPanel>
            </Border>

            <!-- Guarded sender: selected row details, send word choice, hex payload, unlock flow -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusL}"
                Padding="{ThemeResource CardPadding}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Send command" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock
                        Text="Select a command from the catalog to send it."
                        Opacity="0.7"
                        Visibility="{x:Bind NotVis(ViewModel.HasSelection)}" />
                    <StackPanel Spacing="{StaticResource InnerSpacing}" Visibility="{x:Bind BoolVis(ViewModel.HasSelection)}">
                        <Grid ColumnSpacing="{StaticResource InnerSpacing}" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.DetailName, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Kind" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.DetailKind, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Vendor" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.DetailVendor, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Word(s)" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.DetailWords, Mode=OneWay}" FontFamily="Cascadia Mono,Consolas" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Safety" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.DetailSafety, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Group" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.DetailGroup, Mode=OneWay}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock
                            Text="{x:Bind ViewModel.DetailDescription, Mode=OneWay}"
                            Opacity="0.8"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{x:Bind ViewModel.DetailNote, Mode=OneWay}"
                            Opacity="0.7"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind TextVis(ViewModel.DetailNote), Mode=OneWay}" />
                        <TextBlock
                            Text="Dangerous command — refused in the console. Consent tokens are issued only by the dedicated pages (Pairings, Factory reset, Firmware update)."
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource StatusWarnBrush}"
                            Visibility="{x:Bind BoolVis(ViewModel.ShowDangerNote), Mode=OneWay}" />
                        <RadioButtons
                            x:Name="SendOptions"
                            Header="Command word"
                            ItemsSource="{x:Bind ViewModel.Options, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.SelectedOptionIndex, Mode=OneWay}"
                            SelectionChanged="OnSendOptionChanged"
                            AutomationProperties.Name="Command word to send">
                            <RadioButtons.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConsoleSendOption">
                                    <TextBlock
                                        Text="{x:Bind Label}"
                                        FontFamily="Cascadia Mono,Consolas"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </RadioButtons.ItemTemplate>
                        </RadioButtons>
                        <TextBox
                            x:Name="PayloadBox"
                            Header="Hex payload"
                            PlaceholderText="01 A2 — empty sends zero bytes"
                            Text="{x:Bind ViewModel.PayloadText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            FontFamily="Cascadia Mono,Consolas"
                            AutomationProperties.Name="Hex payload to send" />
                        <TextBlock
                            Text="{x:Bind ViewModel.PayloadErrorText, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource StatusBadBrush}"
                            Visibility="{x:Bind TextVis(ViewModel.PayloadErrorText), Mode=OneWay}" />
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusL}"
                            Padding="12"
                            Visibility="{x:Bind BoolVis(ViewModel.ShowUnlock), Mode=OneWay}">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="Blocked command"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource StatusWarnBrush}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.UnlockPrompt, Mode=OneWay}"
                                    Opacity="0.8"
                                    TextWrapping="Wrap" />
                                <TextBox
                                    x:Name="UnlockBox"
                                    Header="Type the command word"
                                    PlaceholderText="e.g. 1604"
                                    Text="{x:Bind ViewModel.UnlockText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    FontFamily="Cascadia Mono,Consolas"
                                    AutomationProperties.Name="Blocked command unlock word" />
                                <Button
                                    Content="Unlock for this session"
                                    HorizontalAlignment="Left"
                                    IsEnabled="{x:Bind ViewModel.CanUnlock, Mode=OneWay}"
                                    Click="OnUnlockClick"
                                    AutomationProperties.Name="Unlock the blocked command for this session" />
                            </StackPanel>
                        </Border>
                        <TextBlock
                            Text="Unlocked for this session — sends attach the session override token."
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource StatusGoodBrush}"
                            Visibility="{x:Bind BoolVis(ViewModel.ShowUnlockBadge), Mode=OneWay}" />
                        <Grid ColumnSpacing="{StaticResource InnerSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Content="Send"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanSend, Mode=OneWay}"
                                Click="OnSendClick"
                                AutomationProperties.Name="Send the command" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.SendNoteText, Mode=OneWay}"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Console log: described TX/RX plus refusals and errors; copy + clear -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusL}"
                Padding="{ThemeResource CardPadding}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="Console log"
                            Style="{StaticResource CardTitleStyle}"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Content="&#xE8C8;" FontFamily="{ThemeResource SymbolThemeFontFamily}" ToolTipService.ToolTip="Copy log"
                            Click="OnCopyLogClick"
                            AutomationProperties.Name="Copy the console log to the clipboard"  Style="{StaticResource IconButtonStyle}" />
                        <Button
                            Grid.Column="2"
                            Content="&#xE894;" FontFamily="{ThemeResource SymbolThemeFontFamily}" ToolTipService.ToolTip="Clear log"
                            Click="OnClearLogClick"
                            AutomationProperties.Name="Clear the console log"  Style="{StaticResource IconButtonStyle}" />
                    </Grid>
                    <ListView
                        x:Name="LogList"
                        ItemsSource="{x:Bind ViewModel.LogLines, Mode=OneWay}"
                        SelectionMode="None"
                        MaxHeight="320"
                        IsItemClickEnabled="False"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollMode="Auto"
                        AutomationProperties.Name="Console TX and RX log">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="32" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConsoleLogRowVm">
                                <Grid Padding="4,2" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind Time}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        FontFamily="Cascadia Mono,Consolas"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Top" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Text}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        FontFamily="Cascadia Mono,Consolas"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        Text="{x:Bind ViewModel.LogCountText, Mode=OneWay}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
