<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns:cp="using:Momentum5.App.Controls"
    x:Class="Momentum5.App.Pages.TracePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cl="using:Momentum5.Client">
	<Grid Margin="{ThemeResource PageMargin}" RowSpacing="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<TextBlock Text="GAIA trace" Style="{StaticResource PageTitleStyle}" />
		<cp:WrapPanel Grid.Row="1" HorizontalSpacing="8" VerticalSpacing="8">
			<ComboBox Header="Direction" SelectedIndex="{x:Bind Vm.DirectionIndex, Mode=TwoWay}" MinWidth="100">
				<x:String>Both</x:String>
				<x:String>TX</x:String>
				<x:String>RX</x:String>
			</ComboBox>
			<TextBox Header="Filter (command or text)" PlaceholderText="S:0603" Text="{x:Bind Vm.CommandFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" />
			<ToggleButton IsChecked="{x:Bind Vm.IsPaused, Mode=TwoWay}" VerticalAlignment="Bottom" Width="{ThemeResource ControlHeight}" Height="{ThemeResource ControlHeight}" Padding="0" ToolTipService.ToolTip="Pause" AutomationProperties.Name="Pause"><FontIcon Glyph="&#xE769;" /></ToggleButton>
			<Button Command="{x:Bind Vm.ClearCommand}" VerticalAlignment="Bottom" ToolTipService.ToolTip="Clear" AutomationProperties.Name="Clear" Style="{StaticResource IconButtonStyle}"><FontIcon Glyph="&#xE894;" /></Button>
			<Button Click="CopyLines_Click" VerticalAlignment="Bottom" ToolTipService.ToolTip="Copy lines" AutomationProperties.Name="Copy lines" Style="{StaticResource IconButtonStyle}"><FontIcon Glyph="&#xE8C8;" /></Button>
			<Button Click="CopyHex_Click" VerticalAlignment="Bottom" ToolTipService.ToolTip="Copy as hex" AutomationProperties.Name="Copy as hex" Style="{StaticResource IconButtonStyle}"><FontIcon Glyph="&#xE943;" /></Button>
			<TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind Vm.CountText, Mode=OneWay}" VerticalAlignment="Bottom" />
		</cp:WrapPanel>
		<ListView x:Name="List" Grid.Row="2" ItemsSource="{x:Bind Vm.Rows}" SelectionMode="Extended" FontFamily="Consolas" FontSize="12">
			<ListView.ItemsPanel>
				<ItemsPanelTemplate>
					<ItemsStackPanel />
				</ItemsPanelTemplate>
			</ListView.ItemsPanel>
			<ListView.ItemTemplate>
				<DataTemplate x:DataType="cl:TraceEntry">
					<TextBlock Text="{x:Bind Line}" IsTextSelectionEnabled="False" TextWrapping="Wrap" />
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>
	</Grid>
</Page>
