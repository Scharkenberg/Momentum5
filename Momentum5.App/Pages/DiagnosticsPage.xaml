<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns:cp="using:Momentum5.App.Controls"
    x:Class="Momentum5.App.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Momentum5.App.ViewModels">
	<cp:ColumnPanel Style="{StaticResource PageColumn}">
		<TextBlock Text="Diagnostics" Style="{StaticResource PageTitleStyle}" />
		<Border Style="{StaticResource CardBorder}">
			<StackPanel Spacing="4">
				<TextBlock Text="Connection info" Style="{StaticResource CardTitleStyle}" />
				<ItemsControl ItemsSource="{x:Bind Info}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:InfoRow">
							<cp:WrapPanel HorizontalSpacing="8" VerticalSpacing="0" Margin="0,3">
								<TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind Label}" MinWidth="96" />
								<TextBlock Text="{x:Bind Value}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
							</cp:WrapPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</Border>
		<cp:WrapPanel>
			<Button Content="GAIA trace" Click="Trace_Click" />
			<Button Content="BLE adverts" Click="Adverts_Click" />
			<Button Content="GATT lab" Click="OpenProbe_Click" />
		</cp:WrapPanel>
		<TextBlock Style="{StaticResource CaptionStyle}" x:Name="LogPath" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
		<cp:WrapPanel>
			<Button Click="OpenLogs_Click" ToolTipService.ToolTip="Open frame log folder" AutomationProperties.Name="Open frame log folder" Style="{StaticResource IconButtonStyle}"><FontIcon Glyph="&#xE838;" /></Button>
			<Button Click="Export_Click" ToolTipService.ToolTip="Export diagnostics (zip)" AutomationProperties.Name="Export diagnostics" Style="{StaticResource IconButtonStyle}"><FontIcon Glyph="&#xE898;" /></Button>
		</cp:WrapPanel>
		<TextBlock x:Name="ExportStatus" TextWrapping="Wrap" />
		<TextBlock Style="{StaticResource CaptionStyle}" Text="The export holds the last 24 hours of frames, a snapshot, settings and environment info. MAC addresses, the serial number and the headset name are masked when anonymization is on (Settings)." TextWrapping="Wrap" />
	</cp:ColumnPanel>
</Page>
