<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns:cp="using:Momentum5.App.Controls"
    x:Class="Momentum5.App.Pages.AdvertsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Momentum5.App.ViewModels">
	<Grid Margin="{ThemeResource PageMargin}" RowSpacing="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<TextBlock Text="BLE adverts" Style="{StaticResource PageTitleStyle}" />
		<TextBlock Style="{StaticResource CaptionStyle}" Grid.Row="1" Text="{x:Bind Vm.Status, Mode=OneWay}" TextWrapping="Wrap" />
		<Button Grid.Row="2" Command="{x:Bind Vm.ScanCommand}" ToolTipService.ToolTip="Scan nearby (8 s)" AutomationProperties.Name="Scan nearby" HorizontalAlignment="Left" Style="{StaticResource IconButtonStyle}"><FontIcon Glyph="&#xE721;" /></Button>
		<ListView Grid.Row="3" ItemsSource="{x:Bind Vm.Rows}" SelectionMode="None">
			<ListView.ItemTemplate>
				<DataTemplate x:DataType="vm:SightingRow">
					<StackPanel Padding="0,4" Spacing="2">
						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
							<TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
							<TextBlock Grid.Column="1" Text="{x:Bind Rssi, Mode=OneWay}" />
						</Grid>
						<TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind AddressText}" FontFamily="Consolas" IsTextSelectionEnabled="True" />
						<cp:WrapPanel HorizontalSpacing="8" VerticalSpacing="0">
							<TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind LastSeen, Mode=OneWay}" />
							<TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind Note, Mode=OneWay}" TextWrapping="Wrap" />
						</cp:WrapPanel>
					</StackPanel>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>
	</Grid>
</Page>
