<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns:cp="using:Momentum5.App.Controls"
    xmlns:c="using:Momentum5.App.Controls"
    x:Class="Momentum5.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Momentum5.App.ViewModels">
	<ScrollViewer>
		<cp:ColumnPanel Style="{StaticResource PageColumn}">
			<TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

			<Border Style="{StaticResource CardBorder}">
				<StackPanel Spacing="{StaticResource InnerSpacing}">
					<TextBlock Text="General" Style="{StaticResource CardTitleStyle}" />
					<c:SwitchRow Title="Connect automatically when the headset appears" IsOn="{x:Bind Vm.AutoConnect, Mode=TwoWay}" />
					<c:SwitchRow Title="Close button hides to the tray" IsOn="{x:Bind Vm.CloseToTray, Mode=TwoWay}" />
					<c:SwitchRow Title="Tray icon opens the quick panel (closes when you click elsewhere)" IsOn="{x:Bind Vm.TrayFlyout, Mode=TwoWay}" />
					<c:SwitchRow Title="Compact mode (small single-panel window)" IsOn="{x:Bind Vm.CompactMode, Mode=TwoWay}" />
					<ComboBox Header="Theme" SelectedIndex="{x:Bind Vm.ThemeIndex, Mode=TwoWay}" MinWidth="160">
						<x:String>Follow system</x:String>
						<x:String>Light</x:String>
						<x:String>Dark</x:String>
					</ComboBox>
				</StackPanel>
			</Border>

			<Border Style="{StaticResource CardBorder}">
				<StackPanel Spacing="{StaticResource InnerSpacing}">
					<TextBlock Text="Notifications" Style="{StaticResource CardTitleStyle}" />
					<c:SwitchRow Title="Headset connected" IsOn="{x:Bind Vm.NotifyConnected, Mode=TwoWay}" />
					<c:SwitchRow Title="Headset disconnected (with reason)" IsOn="{x:Bind Vm.NotifyDisconnected, Mode=TwoWay}" />
					<c:SwitchRow Title="Battery below 15 %" IsOn="{x:Bind Vm.NotifyBatteryLow, Mode=TwoWay}" />
					<c:SwitchRow Title="Charging state changes" IsOn="{x:Bind Vm.NotifyCharging, Mode=TwoWay}" />
					<c:SwitchRow Title="Read-only firmware warning" IsOn="{x:Bind Vm.NotifyReadOnly, Mode=TwoWay}" />
				</StackPanel>
			</Border>

			<Border Style="{StaticResource CardBorder}">
				<StackPanel Spacing="{StaticResource InnerSpacing}">
					<TextBlock Text="Global hotkeys" Style="{StaticResource CardTitleStyle}" />
					<TextBox Header="Noise cancelling" Text="{x:Bind Vm.AncGesture, Mode=TwoWay}" />
					<TextBox Header="Transparency" Text="{x:Bind Vm.TransparencyGesture, Mode=TwoWay}" />
					<TextBox Header="Immersive audio" Text="{x:Bind Vm.ImmersiveGesture, Mode=TwoWay}" />
					<cp:WrapPanel>
						<Button Command="{x:Bind Vm.ApplyHotkeysCommand}" ToolTipService.ToolTip="Apply hotkeys" AutomationProperties.Name="Apply hotkeys" Style="{StaticResource IconButtonStyle}"><FontIcon Glyph="&#xE73E;" /></Button>
						<Button Command="{x:Bind Vm.ResetHotkeysCommand}" ToolTipService.ToolTip="Reset to defaults" AutomationProperties.Name="Reset to defaults" Style="{StaticResource IconButtonStyle}"><FontIcon Glyph="&#xE777;" /></Button>
					</cp:WrapPanel>
					<TextBlock Style="{StaticResource CaptionStyle}" Text="Use Win, Ctrl, Alt, Shift plus one letter, digit or F-key, for example Win+Alt+A. Leave empty to disable." TextWrapping="Wrap" />
					<TextBlock Text="{x:Bind Vm.HotkeyStatusText, Mode=OneWay}" TextWrapping="Wrap" />
				</StackPanel>
			</Border>

			<Border Style="{StaticResource CardBorder}">
				<StackPanel Spacing="{StaticResource InnerSpacing}">
					<TextBlock Text="Location zones" Style="{StaticResource CardTitleStyle}" />
					<TextBlock Style="{StaticResource CaptionStyle}" Text="Off by default. When on, Windows location is checked about once a minute and a zone's mode and preset are applied when you enter it." TextWrapping="Wrap" />
					<c:SwitchRow Title="Use location zones" IsOn="{x:Bind Vm.ZonesEnabled, Mode=TwoWay}" />
					<ItemsControl ItemsSource="{x:Bind Vm.Zones}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:ZoneRow">
								<Grid ColumnDefinitions="*,Auto" Padding="0,4">
									<StackPanel>
										<TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
										<TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind Detail}" TextWrapping="Wrap" />
									</StackPanel>
									<Button Grid.Column="1" Click="RemoveZone_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Remove" AutomationProperties.Name="Remove" Style="{StaticResource IconButtonStyle}"><FontIcon Glyph="&#xE74D;" /></Button>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<TextBox Header="New zone name" Text="{x:Bind Vm.NewZoneName, Mode=TwoWay}" />
					<cp:WrapPanel>
						<TextBox Header="Latitude" Text="{x:Bind Vm.NewZoneLatitude, Mode=TwoWay}" Width="136" />
						<TextBox Header="Longitude" Text="{x:Bind Vm.NewZoneLongitude, Mode=TwoWay}" Width="136" />
						<NumberBox Header="Radius (m)" Minimum="20" Maximum="50000" Value="{x:Bind Vm.NewZoneRadius, Mode=TwoWay}" Width="136" SpinButtonPlacementMode="Compact" />
					</cp:WrapPanel>
					<cp:WrapPanel>
						<ComboBox Header="Mode" SelectedIndex="{x:Bind Vm.NewZoneModeIndex, Mode=TwoWay}" MinWidth="136">
							<x:String>No change</x:String>
							<x:String>Noise cancelling</x:String>
							<x:String>Transparency</x:String>
							<x:String>Both off</x:String>
						</ComboBox>
						<ComboBox Header="Sound preset" ItemsSource="{x:Bind Vm.PresetNames}" SelectedItem="{x:Bind Vm.NewZonePreset, Mode=TwoWay}" PlaceholderText="No change" MinWidth="150" />
					</cp:WrapPanel>
					<cp:WrapPanel>
						<Button Command="{x:Bind Vm.UseCurrentLocationCommand}" ToolTipService.ToolTip="Use my location" AutomationProperties.Name="Use my location" Style="{StaticResource IconButtonStyle}"><FontIcon Glyph="&#xE81D;" /></Button>
						<Button Command="{x:Bind Vm.AddZoneCommand}" ToolTipService.ToolTip="Add zone" AutomationProperties.Name="Add zone" Style="{StaticResource IconButtonStyle}"><FontIcon Glyph="&#xE710;" /></Button>
					</cp:WrapPanel>
					<TextBlock Text="{x:Bind Vm.ZoneMessage, Mode=OneWay}" TextWrapping="Wrap" />
				</StackPanel>
			</Border>

			<Border Style="{StaticResource CardBorder}">
				<StackPanel Spacing="{StaticResource InnerSpacing}">
					<TextBlock Text="Diagnostics" Style="{StaticResource CardTitleStyle}" />
					<ComboBox Header="Log level" SelectedIndex="{x:Bind Vm.LogLevelIndex, Mode=TwoWay}" MinWidth="160">
						<x:String>Error</x:String>
						<x:String>Warning</x:String>
						<x:String>Information</x:String>
						<x:String>Debug</x:String>
					</ComboBox>
					<c:SwitchRow Title="Anonymize exported diagnostics" IsOn="{x:Bind Vm.Anonymize, Mode=TwoWay}" />
					<Button Click="OpenLogs_Click" ToolTipService.ToolTip="Open logs folder" AutomationProperties.Name="Open logs folder" Style="{StaticResource IconButtonStyle}"><FontIcon Glyph="&#xE838;" /></Button>
				</StackPanel>
			</Border>

			<Border Style="{StaticResource CardBorder}">
				<StackPanel Spacing="{StaticResource InnerSpacing}">
					<TextBlock Text="Developer mode" Style="{StaticResource CardTitleStyle}" />
					<TextBlock Style="{StaticResource CaptionStyle}" Text="Unlocks the Advanced page and lets gated commands run on firmware that is not fully verified. Can change headset behaviour; use with care." TextWrapping="Wrap" />
					<cp:WrapPanel Visibility="{x:Bind Locked(Vm.DevModeUnlocked), Mode=OneWay}">
						<TextBox Header="Type MOMENTUM5 to confirm" Text="{x:Bind Vm.UnlockText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="220" />
						<Button Content="Unlock" Command="{x:Bind Vm.UnlockCommand}" VerticalAlignment="Bottom" />
					</cp:WrapPanel>
					<cp:WrapPanel Visibility="{x:Bind Unlocked(Vm.DevModeUnlocked), Mode=OneWay}">
						<TextBlock Text="Developer mode is on." VerticalAlignment="Center" />
						<Button Content="Lock" Command="{x:Bind Vm.LockCommand}" />
					</cp:WrapPanel>
				</StackPanel>
			</Border>

			<TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind Vm.AboutText}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
		</cp:ColumnPanel>
	</ScrollViewer>
</Page>
