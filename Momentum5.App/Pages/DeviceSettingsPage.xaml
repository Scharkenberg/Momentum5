<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns:cp="using:Momentum5.App.Controls"
    x:Class="Momentum5.App.Pages.DeviceSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Momentum5.App.Controls">
	<ScrollViewer>
		<cp:ColumnPanel Style="{StaticResource PageColumn}">
			<StackPanel>
				<TextBlock Text="Device settings" Style="{StaticResource PageTitleStyle}" />
				<TextBlock Style="{StaticResource CaptionStyle}" Text="Configure your Sennheiser headphones." />
			</StackPanel>

			<Border Style="{StaticResource CardBorder}">
				<StackPanel Spacing="{StaticResource InnerSpacing}">
					<cp:WrapPanel HorizontalSpacing="8" VerticalSpacing="0">
						<TextBlock Style="{StaticResource CaptionStyle}" Text="Firmware" MinWidth="96" />
						<TextBlock Text="{x:Bind Vm.FirmwareText, Mode=OneWay}" TextWrapping="Wrap" />
					</cp:WrapPanel>
					<cp:WrapPanel HorizontalSpacing="8" VerticalSpacing="0">
						<TextBlock Style="{StaticResource CaptionStyle}" Text="Codec" MinWidth="96" />
						<TextBlock Text="{x:Bind Vm.CodecText, Mode=OneWay}" TextWrapping="Wrap" />
					</cp:WrapPanel>
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
						<cp:WrapPanel HorizontalSpacing="8" VerticalSpacing="0">
							<TextBlock Style="{StaticResource CaptionStyle}" Text="Name" MinWidth="96" VerticalAlignment="Center" />
							<TextBlock Text="{x:Bind Vm.NameText, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" />
						</cp:WrapPanel>
						<Button Grid.Column="1" Click="Name_Click" ToolTipService.ToolTip="Name &amp; product info" AutomationProperties.Name="Name and product info" Style="{StaticResource IconButtonStyle}"><FontIcon Glyph="&#xE946;" /></Button>
					</Grid>
				</StackPanel>
			</Border>

			<Border Style="{StaticResource CardBorder}">
				<StackPanel Spacing="{StaticResource InnerSpacing}">
					<c:ToggleRow Title="On-head detection" Setting="{x:Bind Vm.WearDetection}" Description="Enable smart pause, hold calls automatically, power saving mode." />
					<StackPanel Margin="10,0,0,0" Spacing="8">
						<c:ToggleRow Title="Smart pause" Setting="{x:Bind Vm.SmartPause}" Description="Pause music by taking headphones off. Continue when putting back on." IsEnabled="{x:Bind Vm.OnHeadOn, Mode=OneWay}" />
						<c:ToggleRow Title="Auto-answer calls" Setting="{x:Bind Vm.AutoAnswer}" Description="Answers calls when you put headphones on." IsEnabled="{x:Bind Vm.OnHeadOn, Mode=OneWay}" />
						<ComboBox Header="Auto power off" SelectedIndex="{x:Bind Vm.AutoOffIndex, Mode=TwoWay}" IsEnabled="{x:Bind Vm.AutoOffEnabled, Mode=OneWay}" HorizontalAlignment="Stretch">
							<x:String>Never</x:String>
							<x:String>15 min</x:String>
							<x:String>30 min</x:String>
							<x:String>60 min</x:String>
						</ComboBox>
						<TextBlock Text="{x:Bind Vm.AutoOff.Warning, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" />
					</StackPanel>
				</StackPanel>
			</Border>

			<Border Style="{StaticResource CardBorder}">
				<c:ToggleRow Title="Comfort calls" Setting="{x:Bind Vm.ComfortCall}" Description="Gives phone calls a more natural sound stage." />
			</Border>

			<Border Style="{StaticResource CardBorder}">
				<StackPanel Spacing="{StaticResource InnerSpacing}">
					<TextBlock Text="Tone &amp; voice prompts" Style="{StaticResource CardTitleStyle}" />
					<RadioButtons SelectedIndex="{x:Bind Vm.PromptUiIndex, Mode=TwoWay}" IsEnabled="{x:Bind Vm.PromptModeSetting.IsEnabled, Mode=OneWay}">
						<x:String>Tone &amp; voice prompts</x:String>
						<x:String>Tone only</x:String>
						<x:String>Off</x:String>
					</RadioButtons>
					<Slider Header="Volume" Minimum="-20" Maximum="6" StepFrequency="1"
					        Value="{x:Bind Vm.PromptVolume.NumericValue, Mode=TwoWay}" IsEnabled="{x:Bind Vm.VolumeEnabled, Mode=OneWay}" />
					<Grid>
						<TextBlock Style="{StaticResource CaptionStyle}" Text="Quiet" />
						<TextBlock Style="{StaticResource CaptionStyle}" Text="Loud" HorizontalAlignment="Right" />
					</Grid>
					<cp:WrapPanel HorizontalSpacing="8" VerticalSpacing="0" Opacity="{x:Bind LanguageOpacity(Vm.LanguageEnabled), Mode=OneWay}">
						<TextBlock Text="Language" />
						<TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind Vm.PromptLanguageText, Mode=OneWay}" TextWrapping="Wrap" />
					</cp:WrapPanel>
				</StackPanel>
			</Border>

			<Border Style="{StaticResource CardBorder}">
				<c:ToggleRow Title="Battery protection mode" Setting="{x:Bind Vm.BatteryProtection}" Description="Prolong battery lifetime. Charging is slower and stops before 100%." />
			</Border>

			<Border Style="{StaticResource CardBorder}">
				<StackPanel Spacing="{StaticResource InnerSpacing}">
					<c:ToggleRow Title="Controls" Setting="{x:Bind Vm.Touch}" Description="Headband gestures cannot be customized." />
					<StackPanel Spacing="4" Opacity="{x:Bind LanguageOpacity(Vm.ControlsOn), Mode=OneWay}">
						<TextBlock Text="Slide down: Volume down" />
						<TextBlock Text="Slide up: Volume up" />
						<TextBlock Text="Spread: Increase transparency" />
						<TextBlock Text="Pinch: Decrease transparency" />
					</StackPanel>
					<StackPanel Visibility="{x:Bind Show(Vm.LowLatencyVisible), Mode=OneWay}">
						<c:ToggleRow Title="Low latency" Setting="{x:Bind Vm.LowLatency}" Description="Reduces audio delay for video and games; may reduce range." />
					</StackPanel>
				</StackPanel>
			</Border>
		</cp:ColumnPanel>
	</ScrollViewer>
</Page>
