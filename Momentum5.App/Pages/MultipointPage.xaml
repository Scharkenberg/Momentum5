<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns:cp="using:Momentum5.App.Controls"
    x:Class="Momentum5.App.Pages.MultipointPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Momentum5.App.ViewModels">
	<ScrollViewer>
		<cp:ColumnPanel Style="{StaticResource PageColumn}">
			<TextBlock Text="Connection management" Style="{StaticResource PageTitleStyle}" />
			<TextBlock Style="{StaticResource CaptionStyle}" Text="Devices paired with the headset (read-only). Pair, connect and forget on the headset or on each device." TextWrapping="Wrap" />
			<Border Style="{StaticResource CardBorder}">
				<StackPanel Spacing="{StaticResource InnerSpacing}">
					<TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
					<ItemsControl ItemsSource="{x:Bind Vm.Slots}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:SlotItem">
								<Grid ColumnDefinitions="*,Auto" Padding="0,6">
									<StackPanel>
										<TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
										<TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind Detail}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
									</StackPanel>
									<FontIcon Grid.Column="1" Glyph="{x:Bind Check}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<Button Command="{x:Bind Vm.RefreshCommand}" ToolTipService.ToolTip="Refresh" AutomationProperties.Name="Refresh" Style="{StaticResource IconButtonStyle}"><FontIcon Glyph="&#xE72C;" /></Button>
				</StackPanel>
			</Border>
			<TextBlock Text="{x:Bind Vm.Message, Mode=OneWay}" TextWrapping="Wrap" />
			<Expander Header="Raw frames (for diagnostics)">
				<TextBlock Text="{x:Bind Vm.Trace, Mode=OneWay}" IsTextSelectionEnabled="True" FontFamily="Consolas" TextWrapping="Wrap" />
			</Expander>
		</cp:ColumnPanel>
	</ScrollViewer>
</Page>
