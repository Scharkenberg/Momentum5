<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns:cp="using:Momentum5.App.Controls"
    xmlns:c="using:Momentum5.App.Controls"
    x:Class="Momentum5.App.Pages.ConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Momentum5.App.ViewModels">

	<ScrollViewer>
		<cp:ColumnPanel Style="{StaticResource PageColumn}">
			<TextBlock Text="Connections" Style="{StaticResource PageTitleStyle}" />

			<InfoBar IsOpen="{x:Bind Vm.RadioOff, Mode=OneWay}" IsClosable="False" Severity="Warning"
			         Title="Bluetooth is off"
			         Message="Turn Bluetooth on in Windows. The app reconnects automatically when it comes back.">
				<InfoBar.ActionButton>
					<HyperlinkButton Content="Bluetooth settings" NavigateUri="ms-settings:bluetooth" />
				</InfoBar.ActionButton>
			</InfoBar>

			<Border Style="{StaticResource CardBorder}">
				<StackPanel Spacing="10">
					<StackPanel Spacing="2">
						<TextBlock Text="{x:Bind Vm.Status.ChipText, Mode=OneWay}" Style="{StaticResource CardTitleStyle}" />
						<TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind Vm.Status.SubText, Mode=OneWay}" TextWrapping="Wrap" />
					</StackPanel>
					<cp:WrapPanel>
						<Button Content="Connect" Command="{x:Bind Vm.ConnectCommand}" Style="{StaticResource PrimaryButtonStyle}" />
						<Button Content="Disconnect" Command="{x:Bind Vm.DisconnectCommand}" IsEnabled="{x:Bind Vm.CanDisconnect, Mode=OneWay}" />
						<Button Command="{x:Bind Vm.RefreshCommand}" ToolTipService.ToolTip="Refresh list" AutomationProperties.Name="Refresh list" Style="{StaticResource IconButtonStyle}"><FontIcon Glyph="&#xE72C;" /></Button>
					</cp:WrapPanel>
					<c:SwitchRow Title="Connect automatically" IsOn="{x:Bind Vm.AutoConnect, Mode=TwoWay}" />
				</StackPanel>
			</Border>

			<Border Style="{StaticResource CardBorder}">
				<StackPanel Spacing="8">
					<TextBlock Text="Paired devices" Style="{StaticResource CardTitleStyle}" />
					<ListView ItemsSource="{x:Bind Vm.Devices}" ItemContainerStyle="{StaticResource OutlinedListItemStyle}" SelectedItem="{x:Bind Vm.SelectedDevice, Mode=TwoWay}" SelectionMode="Single"
					          AutomationProperties.Name="Paired Bluetooth devices">
						<ListView.ItemTemplate>
							<DataTemplate x:DataType="vm:DeviceItem">
								<StackPanel Padding="0,6" Spacing="2">
									<TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
									<TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind AddressText}" FontFamily="Consolas" />
									<TextBlock Style="{StaticResource CaptionStyle}">
										<Run Text="{x:Bind StateText}" /> <Run Text="{x:Bind TargetText}" />
									</TextBlock>
								</StackPanel>
							</DataTemplate>
						</ListView.ItemTemplate>
					</ListView>
					<TextBlock Style="{StaticResource CaptionStyle}" Text="Headset names can be changed by the user, so every paired device is listed." TextWrapping="Wrap" />
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
						<TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind Vm.LastAddressText, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" />
						<Button Grid.Column="1" Command="{x:Bind Vm.ForgetCommand}" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="Forget in this app"
						        ToolTipService.ToolTip="Forget in this app (clears the remembered headset here only; the Windows pairing stays)"><FontIcon Glyph="&#xE74D;" /></Button>
					</Grid>
				</StackPanel>
			</Border>
		</cp:ColumnPanel>
	</ScrollViewer>
</Page>
