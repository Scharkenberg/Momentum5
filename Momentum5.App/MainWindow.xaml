<!-- MainWindow.xaml -->
<Window
    x:Class="Momentum5.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Momentum5.App"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Momentum5 Diagnostics"
    Activated="Window_Activated"
    Closed="Window_Closed">

	<Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="240" />
		</Grid.RowDefinitions>

		<!-- Top bar -->
		<Border Grid.Row="0"
                Padding="16,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
			<Grid ColumnSpacing="16">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel Orientation="Vertical" Spacing="4">
					<TextBlock Text="Momentum5 Diagnostics"
                               FontSize="22"
                               FontWeight="SemiBold" />
					<TextBlock Text="Bluetooth LE probe shell for discovery, state inspection, and protocol mapping."
                               Opacity="0.72"
                               TextWrapping="WrapWholeWords" />
				</StackPanel>

				<StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
					<Border Padding="12,7"
                            CornerRadius="999"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<muxc:ProgressRing Width="14"
                                               Height="14"
                                               IsActive="{x:Bind IsBusy, Mode=OneWay}" />
							<TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
						</StackPanel>
					</Border>
				</StackPanel>
			</Grid>
		</Border>

		<!-- Main work area -->
		<Grid Grid.Row="1" Padding="16" ColumnSpacing="16">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="360" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!-- Left: device discovery -->
			<Border Grid.Column="0"
                    Padding="14"
                    CornerRadius="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
				<Grid RowSpacing="14">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<StackPanel Spacing="8">
						<TextBlock Text="Discovery"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
						<TextBlock Text="Scan, pick the device, then connect."
                                   Opacity="0.7"
                                   TextWrapping="WrapWholeWords" />
					</StackPanel>

					<Grid Grid.Row="1" RowSpacing="8">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<StackPanel Orientation="Horizontal" Spacing="8">
							<Button Content="Scan"
                                    MinWidth="88"
                                    Click="Scan_Click" />
							<Button Content="Probe"
                                    MinWidth="88"
                                    Click="Probe_Click" />
							<Button Content="Clear"
                                    MinWidth="88"
                                    Click="Clear_Click" />
						</StackPanel>

						<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
							<Button Content="Connect"
                                    MinWidth="88"
                                    Click="Connect_Click" />
							<Button Content="Enumerate"
                                    MinWidth="88"
                                    Click="Enumerate_Click" />
							<Button Content="Disconnect"
                                    MinWidth="96"
                                    Click="Disconnect_Click" />
						</StackPanel>
					</Grid>
					<StackPanel Grid.Row="2" Spacing="6">
						<TextBlock Text="Manual target address"
								   FontWeight="SemiBold" />
						<TextBox x:Name="AddressBox"							
								 PlaceholderText="0xA1B2C3D4E5F6  or  A1:B2:C3:D4:E5:F6  or  A1 B2 C3 D4 E5 F6"		  
								 TextChanged="AddressBox_TextChanged"									 
								 KeyDown="AddressBox_KeyDown"							 
								 AcceptsReturn="False" />
						<TextBlock Text="{x:Bind TargetAddressText, Mode=OneWay}"	
								   Opacity="0.68"		  
								   FontSize="12"	
								   TextWrapping="WrapWholeWords" />
						<TextBlock Text="This overrides the selected scan result when present."		 
								   Opacity="0.68"			   
								   FontSize="12"												 
								   TextWrapping="WrapWholeWords" />
					</StackPanel>
					<Grid Grid.Row="3" RowSpacing="10">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<StackPanel Spacing="6">
							<TextBlock Text="Discovered devices"
                                       FontWeight="SemiBold" />
							<TextBlock Text="{x:Bind DeviceSummaryText, Mode=OneWay}"
                                       Opacity="0.72"
                                       TextWrapping="WrapWholeWords" />
						</StackPanel>

						<ListView Grid.Row="1"
                                  ItemsSource="{x:Bind Devices, Mode=OneWay}"
                                  SelectedItem="{x:Bind SelectedDevice, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  IsItemClickEnabled="True"
                                  ItemClick="DevicesList_ItemClick"
                                  ScrollViewer.VerticalScrollMode="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
							<ListView.ItemTemplate>
								<DataTemplate x:DataType="local:DeviceViewModel">
									<Border Padding="10"
                                            CornerRadius="12"
                                            Margin="0,0,0,8"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
										<StackPanel Spacing="3">
											<TextBlock Text="{x:Bind DisplayName}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
											<TextBlock Text="{x:Bind SecondaryLine}"
                                                       FontSize="12"
                                                       Opacity="0.68"
                                                       TextWrapping="WrapWholeWords" />
										</StackPanel>
									</Border>
								</DataTemplate>
							</ListView.ItemTemplate>
						</ListView>
					</Grid>
				</Grid>
			</Border>

			<!-- Right: details, services, notifications -->
			<Grid Grid.Column="1" RowSpacing="16">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<Border Padding="14"
                        CornerRadius="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
					<Grid ColumnSpacing="16">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<StackPanel Spacing="8">
							<TextBlock Text="Current target"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
							<TextBlock Text="{x:Bind SelectedDeviceDetails, Mode=OneWay}"
                                       TextWrapping="WrapWholeWords"
                                       Opacity="0.8" />
						</StackPanel>

						<StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
							<Border Padding="12,7"
                                    CornerRadius="999"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
								<TextBlock Text="{x:Bind ServiceCountText, Mode=OneWay}"
                                           FontWeight="SemiBold" />
							</Border>
							<Border Padding="12,7"
                                    CornerRadius="999"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
								<TextBlock Text="{x:Bind NotificationCountText, Mode=OneWay}"
                                           FontWeight="SemiBold" />
							</Border>
						</StackPanel>
					</Grid>
				</Border>

				<Grid Grid.Row="1" ColumnSpacing="16">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="1.15*" />
						<ColumnDefinition Width="0.85*" />
					</Grid.ColumnDefinitions>

					<Border Grid.Column="0"
                            Padding="14"
                            CornerRadius="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
						<Grid RowSpacing="12">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<StackPanel Spacing="4">
								<StackPanel Orientation="Horizontal"   
											HorizontalAlignment="Stretch"	 
											VerticalAlignment="Center"		 
											Spacing="8">   
									<TextBlock Text="Services and characteristics" 
											   FontSize="18"				 
											   FontWeight="SemiBold"	  
											   VerticalAlignment="Center" />
									<Button Click="SaveGattDump_Click"	  
											ToolTipService.ToolTip="Save GATT dump"			 
											VerticalAlignment="Center" 
											Padding="8,4"				
											MinWidth="0">
										<SymbolIcon Symbol="Save" />
									</Button>
									<Button Click="CaptureGattDump_Click"	   
											ToolTipService.ToolTip="Capture 15s GATT state dump"
											VerticalAlignment="Center"																		
											Padding="8,4"			 
											MinWidth="0">
										<FontIcon Glyph="&#xE7C3;" />
									</Button>
								</StackPanel>
								<TextBlock Text="This becomes the protocol map once you connect."
                                           Opacity="0.7" />
							</StackPanel>

							<ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
								<ItemsControl ItemsSource="{x:Bind Services, Mode=OneWay}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="local:ServiceViewModel">
											<Border Margin="0,0,0,12"
                                                    Padding="12"
                                                    CornerRadius="12"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
												<StackPanel Spacing="8">
													<StackPanel Spacing="2">
														<TextBlock Text="{x:Bind Summary}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="WrapWholeWords" />
														<TextBlock Text="{x:Bind UuidText}"
                                                                   Opacity="0.65"
                                                                   FontSize="12" />
													</StackPanel>

													<ItemsControl ItemsSource="{x:Bind Characteristics}">
														<ItemsControl.ItemTemplate>
															<DataTemplate x:DataType="local:CharacteristicViewModel">
																<Border Padding="10"
                                                                        Margin="0,0,0,8"
                                                                        CornerRadius="10"
                                                                        Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
																	<StackPanel Spacing="2">
																		<TextBlock Text="{x:Bind Summary}"
                                                                                   FontWeight="SemiBold"
                                                                                   TextWrapping="WrapWholeWords" />
																		<TextBlock Text="{x:Bind DetailLine}"
                                                                                   Opacity="0.68"
                                                                                   FontSize="12"
                                                                                   TextWrapping="WrapWholeWords" />
																	</StackPanel>
																</Border>
															</DataTemplate>
														</ItemsControl.ItemTemplate>
													</ItemsControl>
												</StackPanel>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</Grid>
					</Border>

					<Border Grid.Column="1"
                            Padding="14"
                            CornerRadius="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
						<Grid RowSpacing="12">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<StackPanel Spacing="4">
								<TextBlock Text="Live notes"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
								<TextBlock Text="Notifications, internal events, and probe output."
                                           Opacity="0.7" />
							</StackPanel>

							<ListView Grid.Row="1"
                                      ItemsSource="{x:Bind Notes, Mode=OneWay}"
                                      IsItemClickEnabled="False"
                                      SelectionMode="None">
								<ListView.ItemTemplate>
									<DataTemplate x:DataType="local:NoteViewModel">
										<Border Padding="10"
                                                Margin="0,0,0,8"
                                                CornerRadius="10"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
											<StackPanel Spacing="3">
												<TextBlock Text="{x:Bind TimestampText}"
                                                           FontSize="11"
                                                           Opacity="0.6" />
												<TextBlock Text="{x:Bind Message}"
                                                           TextWrapping="WrapWholeWords" />
											</StackPanel>
										</Border>
									</DataTemplate>
								</ListView.ItemTemplate>
							</ListView>
						</Grid>
					</Border>
				</Grid>
			</Grid>
		</Grid>

		<!-- Bottom log -->
		<Border Grid.Row="2"
                Padding="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0">
			<Grid RowSpacing="10">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<StackPanel Orientation="Horizontal" Spacing="12">
					<TextBlock Text="Raw log"
                               FontSize="18"
                               FontWeight="SemiBold" />
					<TextBlock Text="{x:Bind LogSummaryText, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Opacity="0.68" />
				</StackPanel>

				<TextBox x:Name="LogBox"
						 Grid.Row="1"
						 Text="{x:Bind RawLogText, Mode=OneWay}"
						 IsReadOnly="True"			   
						 AcceptsReturn="True"		  
						 TextWrapping="NoWrap"	   
						 FontFamily="Consolas"			  
						 ScrollViewer.VerticalScrollBarVisibility="Auto" 
						 ScrollViewer.HorizontalScrollBarVisibility="Auto" />
			</Grid>
		</Border>
	</Grid>
</Window>