<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Momentum5.App.Shell.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Momentum5">

	<Window.SystemBackdrop>
		<MicaBackdrop Kind="BaseAlt" />
	</Window.SystemBackdrop>

	<Grid x:Name="Root">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- Custom title bar: follows the app theme; caption buttons are tinted in code -->
		<Grid x:Name="TitleBarRoot" Height="48">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition x:Name="InsetColumn" Width="140" />
			</Grid.ColumnDefinitions>
			<StackPanel x:Name="DragArea" Orientation="Horizontal" Spacing="10" Padding="14,0,0,0" Background="Transparent">
				<Image x:Name="LogoImage" Width="24" Height="24" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
				<TextBlock x:Name="TitleText" Text="Momentum5" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
				<Ellipse x:Name="TitleDot" Width="8" Height="8" VerticalAlignment="Center" />
			</StackPanel>
			<Button x:Name="CompactButton" Grid.Column="1" Click="CompactButton_Click" Style="{StaticResource CaptionLikeButton}"
			        ToolTipService.ToolTip="Compact mode" AutomationProperties.Name="Compact mode">
				<FontIcon x:Name="CompactGlyph" Glyph="&#xE73F;" FontSize="10" />
			</Button>
		</Grid>

		<NavigationView x:Name="Nav" Grid.Row="1" IsTitleBarAutoPaddingEnabled="False"
		                PaneOpened="Nav_PaneChanged" PaneClosed="Nav_PaneChanged" DisplayModeChanged="Nav_DisplayModeChanged"
		                PaneDisplayMode="Auto"
		                CompactModeThresholdWidth="560"
		                ExpandedModeThresholdWidth="1000"
		                IsSettingsVisible="False"
		                IsBackButtonVisible="Collapsed"
		                OpenPaneLength="240"
		                SelectionChanged="Nav_SelectionChanged">
			<NavigationView.MenuItems>
				<NavigationViewItem Content="My device" Tag="Dashboard" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
				<NavigationViewItem Content="Noise control" Tag="Noise"><NavigationViewItem.Icon><FontIcon Glyph="&#xE767;" /></NavigationViewItem.Icon></NavigationViewItem>
				<NavigationViewItem Content="Sound" Tag="Sound"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D6;" /></NavigationViewItem.Icon></NavigationViewItem>
				<NavigationViewItem Content="Immersive audio" Tag="Spatial"><NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon></NavigationViewItem>
				<NavigationViewItem Content="Headset link" Tag="Connections"><NavigationViewItem.Icon><FontIcon Glyph="&#xE702;" /></NavigationViewItem.Icon></NavigationViewItem>
				<NavigationViewItem Content="Connection management" Tag="Multipoint"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7F8;" /></NavigationViewItem.Icon></NavigationViewItem>
				<NavigationViewItem Content="Device settings" Tag="DeviceSettings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon></NavigationViewItem>
				<NavigationViewItem Content="Diagnostics" Tag="Diagnostics"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon></NavigationViewItem>
				<NavigationViewItem x:Name="AdvancedItem" Content="Advanced" Tag="Advanced" Visibility="Collapsed"><NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></NavigationViewItem.Icon></NavigationViewItem>
			</NavigationView.MenuItems>
			<NavigationView.FooterMenuItems>
				<NavigationViewItem Content="Settings" Tag="Settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE115;" /></NavigationViewItem.Icon></NavigationViewItem>
			</NavigationView.FooterMenuItems>
			<NavigationView.PaneFooter>
				<Border x:Name="StatusChip" Margin="12,8" Padding="10,6" CornerRadius="{StaticResource RadiusM}" Tapped="StatusChip_Tapped"
				        Background="{ThemeResource PillBrush}"
				        AutomationProperties.LiveSetting="Polite">
					<StackPanel x:Name="ChipRow" Orientation="Horizontal" Spacing="8">
						<Ellipse x:Name="StatusDot" Width="10" Height="10" VerticalAlignment="Center" />
						<TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="190" />
					</StackPanel>
				</Border>
			</NavigationView.PaneFooter>
	
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<Rectangle Grid.RowSpan="2" Fill="{ThemeResource AmbientGlowBrush}" IsHitTestVisible="False" />
				<InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="True" IsOpen="False" Margin="16,8,16,0" />
				<Frame x:Name="ContentFrame" Grid.Row="1" />
			</Grid>
		</NavigationView>

		<Grid x:Name="CompactHost" Grid.Row="1" Visibility="Collapsed" />
	</Grid>
</Window>
