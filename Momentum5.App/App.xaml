<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Momentum5.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Momentum5.App"
    xmlns:m="using:Momentum5.App.Services"
    xmlns:cp="using:Momentum5.App.Controls">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
			</ResourceDictionary.MergedDictionaries>

			<ResourceDictionary.ThemeDictionaries>
				<ResourceDictionary x:Key="Default">
					<SolidColorBrush x:Key="CaptionHoverBrush" Color="#26FFFFFF" />
					<SolidColorBrush x:Key="CaptionPressedBrush" Color="#40FFFFFF" />
					<LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#2A2840" Offset="0" />
						<GradientStop Color="#1D1C2E" Offset="1" />
					</LinearGradientBrush>
					<SolidColorBrush x:Key="CardEdgeBrush" Color="#33FFFFFF" />
					<LinearGradientBrush x:Key="AmbientGlowBrush" StartPoint="0.2,0" EndPoint="0.8,1">
						<GradientStop Color="#337C5CFF" Offset="0" />
						<GradientStop Color="#00000000" Offset="0.55" />
					</LinearGradientBrush>
					<SolidColorBrush x:Key="StatusGoodBrush" Color="#6CCB5F" />
					<SolidColorBrush x:Key="StatusWarnBrush" Color="#FCE100" />
					<SolidColorBrush x:Key="StatusBadBrush" Color="#FF99A4" />
					<SolidColorBrush x:Key="PillBrush" Color="#22FFFFFF" />
				</ResourceDictionary>
				<ResourceDictionary x:Key="Dark">
					<SolidColorBrush x:Key="CaptionHoverBrush" Color="#26FFFFFF" />
					<SolidColorBrush x:Key="CaptionPressedBrush" Color="#40FFFFFF" />
					<LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#2A2840" Offset="0" />
						<GradientStop Color="#1D1C2E" Offset="1" />
					</LinearGradientBrush>
					<SolidColorBrush x:Key="CardEdgeBrush" Color="#33FFFFFF" />
					<LinearGradientBrush x:Key="AmbientGlowBrush" StartPoint="0.2,0" EndPoint="0.8,1">
						<GradientStop Color="#337C5CFF" Offset="0" />
						<GradientStop Color="#00000000" Offset="0.55" />
					</LinearGradientBrush>
					<SolidColorBrush x:Key="StatusGoodBrush" Color="#6CCB5F" />
					<SolidColorBrush x:Key="StatusWarnBrush" Color="#FCE100" />
					<SolidColorBrush x:Key="StatusBadBrush" Color="#FF99A4" />
					<SolidColorBrush x:Key="PillBrush" Color="#22FFFFFF" />
				</ResourceDictionary>
				<ResourceDictionary x:Key="Light">
					<SolidColorBrush x:Key="CaptionHoverBrush" Color="#1A000000" />
					<SolidColorBrush x:Key="CaptionPressedBrush" Color="#2E000000" />
					<LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#FFFFFF" Offset="0" />
						<GradientStop Color="#F3F1FF" Offset="1" />
					</LinearGradientBrush>
					<SolidColorBrush x:Key="CardEdgeBrush" Color="#1A4F46E5" />
					<LinearGradientBrush x:Key="AmbientGlowBrush" StartPoint="0.2,0" EndPoint="0.8,1">
						<GradientStop Color="#226C5CFF" Offset="0" />
						<GradientStop Color="#00FFFFFF" Offset="0.55" />
					</LinearGradientBrush>
					<SolidColorBrush x:Key="StatusGoodBrush" Color="#0F7B0F" />
					<SolidColorBrush x:Key="StatusWarnBrush" Color="#9D5D00" />
					<SolidColorBrush x:Key="StatusBadBrush" Color="#C42B1C" />
					<SolidColorBrush x:Key="PillBrush" Color="#146C5CFF" />
				</ResourceDictionary>
			</ResourceDictionary.ThemeDictionaries>

			<!-- Brand accent ramp (violet) overrides the system accent app-wide -->
			<Color x:Key="SystemAccentColor">#6C5CFF</Color>
			<Color x:Key="SystemAccentColorDark1">#5548E0</Color>
			<Color x:Key="SystemAccentColorDark2">#4136B8</Color>
			<Color x:Key="SystemAccentColorDark3">#2E2680</Color>
			<Color x:Key="SystemAccentColorLight1">#8A7DFF</Color>
			<Color x:Key="SystemAccentColorLight2">#A99FFF</Color>
			<Color x:Key="SystemAccentColorLight3">#C7C1FF</Color>

			<!-- Gradients -->
			<LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
				<GradientStop Color="#6C5CFF" Offset="0" />
				<GradientStop Color="#2BB3F0" Offset="1" />
			</LinearGradientBrush>
			<LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
				<GradientStop Color="#4F46E5" Offset="0" />
				<GradientStop Color="#7C3AED" Offset="0.55" />
				<GradientStop Color="#0EA5E9" Offset="1" />
			</LinearGradientBrush>
			<LinearGradientBrush x:Key="HeroSheenBrush" StartPoint="0,0" EndPoint="0,1">
				<GradientStop Color="#33FFFFFF" Offset="0" />
				<GradientStop Color="#00FFFFFF" Offset="0.6" />
			</LinearGradientBrush>

			<!-- Control restyling through lightweight resources -->
			<StaticResource x:Key="SliderTrackValueFill" ResourceKey="BrandGradientBrush" />
			<StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="BrandGradientBrush" />
			<StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="BrandGradientBrush" />
			<StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="BrandGradientBrush" />
			<StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="BrandGradientBrush" />
			<StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="BrandGradientBrush" />
			<x:Double x:Key="SliderTrackThemeHeight">6</x:Double>


			<!-- Spacing and target-size tokens (U-20) -->
			<x:Double x:Key="SpaceS">8</x:Double>
			<x:Double x:Key="SpaceM">16</x:Double>
			<x:Double x:Key="SpaceL">32</x:Double>
			<x:Double x:Key="MinTarget">44</x:Double>

			<!-- Density tokens (a compact host overrides these on its own subtree) -->
			<Thickness x:Key="CardPadding">14,12</Thickness>
			<Thickness x:Key="PageMargin">20,12,20,20</Thickness>
			<x:Double x:Key="PageSpacing">10</x:Double>
			<x:Double x:Key="InnerSpacing">8</x:Double>
			<x:Double x:Key="PageTitleFontSize">22</x:Double>
			<x:Double x:Key="CardTitleFontSize">15</x:Double>
			<x:Double x:Key="RowMinHeight">36</x:Double>
			<x:Double x:Key="ControlHeight">28</x:Double>
			<Thickness x:Key="ControlPadding">10,0</Thickness>
			<Thickness x:Key="ListItemPadding">10,2</Thickness>
			<x:Double x:Key="ControlFontSize">14</x:Double>
			<x:Double x:Key="IconGlyphSize">16</x:Double>

			<!-- Corner radii: rounded rectangles everywhere (no pills). Controls follow ControlCornerRadius. -->
			<CornerRadius x:Key="RadiusS">4</CornerRadius>
			<CornerRadius x:Key="RadiusM">6</CornerRadius>
			<CornerRadius x:Key="RadiusL">8</CornerRadius>
			<CornerRadius x:Key="RadiusXL">12</CornerRadius>
			<CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
			<CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

			<!-- Cards: gradient surface, soft edge, large radius, staggered reveal -->
			<Style x:Key="CardBorder" TargetType="Border">
				<Setter Property="Padding" Value="{ThemeResource CardPadding}" />
				<Setter Property="CornerRadius" Value="{StaticResource RadiusL}" />
				<Setter Property="cp:ColumnPanel.Flow" Value="True" />
				<Setter Property="Background" Value="{ThemeResource CardGradientBrush}" />
				<Setter Property="BorderBrush" Value="{ThemeResource CardEdgeBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="m:Motion.Reveal" Value="True" />
			</Style>
			<Style x:Key="PillBorder" TargetType="Border">
				<Setter Property="Padding" Value="10,3" />
				<Setter Property="CornerRadius" Value="{StaticResource RadiusS}" />
				<Setter Property="Background" Value="{ThemeResource PillBrush}" />
			</Style>
			<!-- Type scale: PageTitle 28 / CardTitle 16 / Body 14 / Caption 12 (secondary) -->
			<Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
				<Setter Property="FontSize" Value="{ThemeResource PageTitleFontSize}" />
				<Setter Property="FontWeight" Value="SemiBold" />
				<Setter Property="Margin" Value="0,0,0,2" />
			</Style>
			<Style x:Key="CardTitleStyle" TargetType="TextBlock">
				<Setter Property="FontSize" Value="{ThemeResource CardTitleFontSize}" />
				<Setter Property="FontWeight" Value="SemiBold" />
				<Setter Property="TextWrapping" Value="Wrap" />
			</Style>
			<Style x:Key="CaptionStyle" TargetType="TextBlock">
				<Setter Property="FontSize" Value="12" />
				<Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
				<Setter Property="TextWrapping" Value="Wrap" />
				<Setter Property="LineHeight" Value="17" />
			</Style>
			<!-- Page column: one margin, spacing and max width for every page -->
			<Style x:Key="PageColumn" TargetType="cp:ColumnPanel">
				<Setter Property="Margin" Value="{ThemeResource PageMargin}" />
				<Setter Property="Spacing" Value="{ThemeResource PageSpacing}" />
				<Setter Property="MaxColumnWidth" Value="1500" />
				<Setter Property="MinColumnWidth" Value="440" />
				<Setter Property="HorizontalAlignment" Value="Stretch" />
			</Style>
			<!-- Looks and behaves like a system caption button (46 wide, full title-bar height, theme-tinted states) -->
			<Style x:Key="CaptionLikeButton" TargetType="Button">
				<Setter Property="Width" Value="46" />
				<Setter Property="MinWidth" Value="46" />
				<Setter Property="MinHeight" Value="0" />
				<Setter Property="Height" Value="48" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="CornerRadius" Value="0" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="VerticalAlignment" Value="Top" />
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Button">
							<Grid x:Name="Root" Background="{TemplateBinding Background}">
								<VisualStateManager.VisualStateGroups>
									<VisualStateGroup x:Name="CommonStates">
										<VisualState x:Name="Normal" />
										<VisualState x:Name="PointerOver">
											<VisualState.Setters>
												<Setter Target="Root.Background" Value="{ThemeResource CaptionHoverBrush}" />
											</VisualState.Setters>
										</VisualState>
										<VisualState x:Name="Pressed">
											<VisualState.Setters>
												<Setter Target="Root.Background" Value="{ThemeResource CaptionPressedBrush}" />
											</VisualState.Setters>
										</VisualState>
										<VisualState x:Name="Disabled">
											<VisualState.Setters>
												<Setter Target="Presenter.Opacity" Value="0.4" />
											</VisualState.Setters>
										</VisualState>
									</VisualStateGroup>
								</VisualStateManager.VisualStateGroups>
								<ContentPresenter x:Name="Presenter" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
							</Grid>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<!-- Crisp icons: whole-pixel layout and fixed size (no text scaling) -->
			<Style TargetType="FontIcon">
				<Setter Property="UseLayoutRounding" Value="True" />
				<Setter Property="IsTextScaleFactorEnabled" Value="False" />
				<Setter Property="FontSize" Value="{ThemeResource IconGlyphSize}" />
			</Style>

			<!-- One control family: every button, field and list row takes its size from the density tokens -->
			<Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
				<Setter Property="MinHeight" Value="{ThemeResource ControlHeight}" />
				<Setter Property="Padding" Value="{ThemeResource ControlPadding}" />
				<Setter Property="FontSize" Value="{ThemeResource ControlFontSize}" />
				<Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
			</Style>
			<Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
				<Setter Property="MinHeight" Value="{ThemeResource ControlHeight}" />
				<Setter Property="Padding" Value="{ThemeResource ControlPadding}" />
				<Setter Property="FontSize" Value="{ThemeResource ControlFontSize}" />
				<Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
			</Style>
			<Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
				<Setter Property="Width" Value="{ThemeResource ControlHeight}" />
				<Setter Property="Height" Value="{ThemeResource ControlHeight}" />
				<Setter Property="MinWidth" Value="0" />
				<Setter Property="MinHeight" Value="0" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="FontSize" Value="{ThemeResource IconGlyphSize}" />
				<Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
				<Setter Property="HorizontalContentAlignment" Value="Center" />
				<Setter Property="VerticalContentAlignment" Value="Center" />
			</Style>
			<Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
				<Setter Property="MinHeight" Value="{ThemeResource ControlHeight}" />
				<Setter Property="FontSize" Value="{ThemeResource ControlFontSize}" />
			</Style>
			<Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
				<Setter Property="MinHeight" Value="{ThemeResource ControlHeight}" />
				<Setter Property="FontSize" Value="{ThemeResource ControlFontSize}" />
			</Style>
			<!-- Selected row = theme accent outline (no vertical pill) -->
			<Style x:Key="OutlinedListItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
				<Setter Property="MinHeight" Value="{ThemeResource RowMinHeight}" />
				<Setter Property="Padding" Value="{ThemeResource ListItemPadding}" />
				<Setter Property="Margin" Value="0,2" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="UseSystemFocusVisuals" Value="True" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ListViewItem">
							<Border x:Name="Root" MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}"
							        CornerRadius="{StaticResource RadiusM}" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
								<VisualStateManager.VisualStateGroups>
									<VisualStateGroup x:Name="CommonStates">
										<VisualState x:Name="Normal" />
										<VisualState x:Name="PointerOver">
											<VisualState.Setters>
												<Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
											</VisualState.Setters>
										</VisualState>
										<VisualState x:Name="Pressed">
											<VisualState.Setters>
												<Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
											</VisualState.Setters>
										</VisualState>
										<VisualState x:Name="Selected">
											<VisualState.Setters>
												<Setter Target="Root.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
												<Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
											</VisualState.Setters>
										</VisualState>
										<VisualState x:Name="PointerOverSelected">
											<VisualState.Setters>
												<Setter Target="Root.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
												<Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
											</VisualState.Setters>
										</VisualState>
										<VisualState x:Name="PressedSelected">
											<VisualState.Setters>
												<Setter Target="Root.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
												<Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
											</VisualState.Setters>
										</VisualState>
										<VisualState x:Name="Disabled">
											<VisualState.Setters>
												<Setter Target="Root.Opacity" Value="0.5" />
											</VisualState.Setters>
										</VisualState>
									</VisualStateGroup>
								</VisualStateManager.VisualStateGroups>
								<ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
								                  ContentTransitions="{TemplateBinding ContentTransitions}"
								                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
								                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
				<Setter Property="MinHeight" Value="{ThemeResource RowMinHeight}" />
				<Setter Property="Padding" Value="{ThemeResource ListItemPadding}" />
			</Style>
			<Style x:Key="CompactCard" TargetType="Border">
				<Setter Property="Padding" Value="10" />
				<Setter Property="CornerRadius" Value="{StaticResource RadiusM}" />
				<Setter Property="Background" Value="{ThemeResource CardGradientBrush}" />
				<Setter Property="BorderBrush" Value="{ThemeResource CardEdgeBrush}" />
				<Setter Property="BorderThickness" Value="1" />
			</Style>

			<Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
				<Setter Property="MinHeight" Value="{ThemeResource ControlHeight}" />
				<Setter Property="Padding" Value="{ThemeResource ControlPadding}" />
				<Setter Property="FontSize" Value="{ThemeResource ControlFontSize}" />
				<Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
			</Style>
		</ResourceDictionary>
	</Application.Resources>
</Application>
